# Root-level — read by docker-compose.yml. POSTGRES_* build the db
# connection string; JWT_SECRET_KEY/FERNET_ENCRYPTION_KEY pass through to
# the backend container (nothing else in docker-compose.yml sets them).
POSTGRES_USER=pia
POSTGRES_PASSWORD=pia_secret
POSTGRES_DB=pricing_intelligence

JWT_SECRET_KEY=dev-only-change-me
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=
