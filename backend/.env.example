# Database (matches docker-compose.yml's db service when run via Docker)
DATABASE_URL=postgresql+asyncpg://pia:pia_secret@localhost:5432/pricing_intelligence
DATABASE_URL_SYNC=postgresql+psycopg2://pia:pia_secret@localhost:5432/pricing_intelligence

# Auth — signs JWTs. Generate a real random value for anything beyond local dev,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me

# Encrypts each workspace's stored AI provider key at rest. Generate once via:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating this breaks decryption of every already-stored key.
FERNET_ENCRYPTION_KEY=

CORS_ORIGINS=["http://localhost:3000"]
